# Base URL of the TriageAI API, baked in at build time.
#
# Leave empty for local development: the Vite dev server proxies /api and /ws
# to the backend, so the app uses same-origin relative URLs.
#
# Set it for a split deployment, e.g. frontend on Vercel, API on Railway:
#   VITE_API_URL=https://triageai-api.up.railway.app
VITE_API_URL=
