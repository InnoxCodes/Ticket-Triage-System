# Every setting has a working default. Copy to .env only to override one.

# ENVIRONMENT=development

# Relative paths resolve against the directory the server is started from.
# DATABASE_URL=sqlite+aiosqlite:///./triageai.db

# Browser origins allowed to call the API, comma-separated. Add your frontend's
# deployed URL here, e.g. a Vercel domain.
# CORS_ORIGINS=http://localhost:5173,https://triageai.vercel.app

# Seconds between injected tickets while the traffic simulator is running.
# SIMULATOR_INTERVAL_SECONDS=12
